{
  "name": "nothing-explorer",
  "version": "0.8.9",
  "description": "A frosted glass file manager for Windows",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "package": "electron-builder --win dir",
    "installer": "electron-builder --win nsis",
    "release": "electron-builder --win nsis --publish always",
    "icon": "electron scripts/render-icon.cjs"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "co.kampungcetak.nothingexplorer",
    "productName": "Nothing Explorer",
    "files": [
      "src/**/*",
      "package.json",
      "assets/**/*",
      "vendor/**/*",
      "THIRD_PARTY.md"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "assets/icon.ico",
      "signExts": [
        "!7z.exe",
        "!7z.dll"
      ]
    },
    "asarUnpack": [
      "src/windows.ps1",
      "src/shell-host.ps1",
      "src/shell-host.cs",
      "src/file-metadata.cs",
      "vendor/7zip/**/*",
      "src/property-sheet.cs",
      "src/shell-image.cs"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nothing Explorer",
      "artifactName": "Nothing-Explorer-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "iniharith",
        "repo": "nothing-explorer",
        "releaseType": "release"
      }
    ],
    "copyright": "Copyright © 2026 INIHARITH"
  },
  "dependencies": {
    "@imagemagick/magick-wasm": "0.0.45",
    "electron-updater": "^6.8.9",
    "heic-decode": "2.1.0",
    "sharp": "0.35.5",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "author": {
    "name": "INIHARITH",
    "url": "https://iniharith.github.io/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iniharith/nothing-explorer.git"
  }
}
